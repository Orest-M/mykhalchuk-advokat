# Copy to .env for local dev. Public vars (PUBLIC_*) are exposed to the client;
# everything else is server-only. Real secrets for the deployed Worker are set
# with `wrangler secret put` and via .dev.vars locally — NOT here.
# All values are placeholders. See docs/ for how to obtain each one.

# --- Analytics (task 11) — public identifiers, safe to expose ---
# Google Tag Manager container id. Empty = no analytics rendered (dev/preview stay clean).
PUBLIC_GTM_ID=

# --- Lead form / Turnstile (task 8) ---
# Cloudflare Turnstile site key (public). Empty = widget not rendered, endpoint skips the check.
PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile secret key (server-only). Set as a Worker secret in production.
TURNSTILE_SECRET_KEY=
# Telegram bot token from @BotFather (server-only).
TELEGRAM_BOT_TOKEN=
# Telegram chat id that receives lead notifications (server-only).
TELEGRAM_CHAT_ID=

# --- Leads storage / export (task 9) ---
# Salt for hashing client IPs before storing in D1 (server-only).
IP_HASH_SALT=
# Token guarding the CSV export endpoint (server-only, optional).
LEADS_EXPORT_TOKEN=
