{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nmp-landing",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  // Static build (`output: 'static'`): the @astrojs/cloudflare adapter emits
  // pre-rendered assets into ./dist/client, so this deploys as an
  // assets-only Worker (no `main` script yet).
  //
  // `not_found_handling: "404-page"` serves /404.html on unknown paths; that
  // page is created in task 10 — until then Cloudflare falls back to its
  // default 404.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  // TODO(task 8): the /api/lead endpoint (`export const prerender = false`)
  // turns this into a script Worker. When that lands, the adapter generates
  // ./dist/_worker.js/index.js — add `"main": "./dist/_worker.js/index.js"`
  // and give `assets` a `"binding": "ASSETS"` (a binding is only allowed once
  // a `main` script exists).
  //
  // TODO(task 9): add the D1 `DB` binding here.
  "observability": {
    "enabled": true
  }
}
